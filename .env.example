# Copy this to .env and fill in your values.
# Never commit .env or your service account key file.

# Your Firebase / GCP project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to your downloaded service account key JSON (local development only —
# on Cloud Run the service's own identity is used instead, no key file needed)
# (Firebase console → Project settings → Service accounts → Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── AI ──────────────────────────────────────────────────────────────
# ollama      = run models locally (default; needs `ollama serve`)
# groq        = Groq free tier for answers (needs GROQ_API_KEY); search matching runs
#               on the server with FastEmbed (pip install -r requirements-cloud.txt)
# huggingface = Hugging Face Inference Providers (paid credits, needs HF_TOKEN)
AI_PROVIDER=ollama
# GROQ_API_KEY=gsk_xxx
# GROQ_MODEL=openai/gpt-oss-20b
# EMBED_PROVIDER=local                 # ollama | local | huggingface (default follows AI_PROVIDER)
# HF_TOKEN=hf_xxx

# ── Paper search libraries ───────────────────────────────────────────
# OpenAlex needs a free API key since Feb 2026: openalex.org → Settings → API
OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.com
# Optional, raises Semantic Scholar's limit (apply at semanticscholar.org/product/api)
# SEMANTIC_SCHOLAR_API_KEY=

# ── Admin portal (/admin) — separate from student accounts ───────────
# Make the hash with:  python -m app.tools.admin_password   (keep the single quotes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='paste-the-hash-here'
# ADMIN_SESSION_HOURS=8
# DASHBOARD_TZ=Asia/Bangkok
# ACCESS_LOG_ENABLED=true

# ── Hosting ─────────────────────────────────────────────────────────
# true when served over HTTPS (Cloud Run sets this in the Dockerfile)
COOKIE_SECURE=false
