# Copy this to .env and fill in your values.
# Never commit .env or your service account key file.

# Your Firebase / GCP project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to your downloaded service account key JSON (local development only —
# on Cloud Run the service's own identity is used instead, no key file needed)
# (Firebase console → Project settings → Service accounts → Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── AI ──────────────────────────────────────────────────────────────
# ollama      = run models locally (default; needs `ollama serve`)
# huggingface = Hugging Face Inference Providers (needs HF_TOKEN)
AI_PROVIDER=ollama
# HF_TOKEN=hf_xxx                      # fine-grained token: "Make calls to Inference Providers"
# HF_CHAT_MODEL=openai/gpt-oss-20b
# HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Admin portal (/admin) — separate from student accounts ───────────
# Make the hash with:  python -m app.tools.admin_password   (keep the single quotes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='paste-the-hash-here'
# ADMIN_SESSION_HOURS=8
# DASHBOARD_TZ=Asia/Bangkok
# ACCESS_LOG_ENABLED=true

# ── Hosting ─────────────────────────────────────────────────────────
# true when served over HTTPS (Cloud Run sets this in the Dockerfile)
COOKIE_SECURE=false
